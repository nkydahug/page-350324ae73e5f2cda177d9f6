-size: 16px}\n\n      .info-panel {padding: 23px}\n\n      .panel-row {grid-template-columns: 80px 1fr}\n\n      .section {padding: 70px 0}\n\n      .plan {padding: 27px 24px}\n\n      .steps {grid-template-columns: 1fr}\n\n      .step,\n      .step + .step,\n      .step:nth-child(3) {min-height: auto;padding: 28px 0;border-left: 0;border-bottom: 1px solid #d9dddf}\n\n      .step::before {margin-bottom: 24px}\n\n      .client-item {grid-template-columns: 48px minmax(0, 1fr);gap: 16px}\n\n      .closing-inner,\n      .footer-inner {align-items: flex-start;flex-direction: column}\n    }\n  </style><header class=\"topbar\">\n    <div class=\"topbar-inner\">\n      <a class=\"brand\" href=\"#top\" aria-label=\"IPLC 首页\">\n        <span class=\"brand-mark\"></span>\n        <span>IPLC</span>\n      </a>\n      <nav class=\"nav\" aria-label=\"页面导航\">\n        <a href=\"#plans\">套餐</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#guide\">使用说明</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n  </header>\n\n  <main id=\"top\">\n    <section class=\"hero\">\n      <div class=\"container hero-grid\">\n        <div>\n          <div class=\"eyebrow\">套餐 · 客户端 · 使用指南</div>\n          <h1>\n            IPLC\n            <span>连接之前，先把选择与步骤说明白</span>\n          </h1>\n          <p class=\"lead\">本页集中整理 IPLC 的月度与年度套餐参考、不同流量额度对应的设备数量，以及客户端准备和配置思路。价格、权益与使用方法按主题分区呈现，便于逐项核对。</p>\n          <div class=\"hero-actions\">\n            <a class=\"button button-primary\" href=\"#plans\">查看套餐</a>\n            <a class=\"button button-secondary\" href=\"#guide\">阅读使用说明</a>\n          </div>\n        </div>\n\n        <aside class=\"info-panel\" aria-label=\"IPLC 页面速览\">\n          <div class=\"panel-label\">QUICK VIEW / 页面速览</div>\n          <dl>\n            <div class=\"panel-row\">\n              <dt>套餐档位</dt>\n              <dd>基础版 / 旗舰版 / 团队版</dd>\n            </div>\n            <div class=\"panel-row\">\n              <dt>计费周期</dt>\n              <dd>按月或按年</dd>\n            </div>\n            <div class=\"panel-row\">\n              <dt>流量范围</dt>\n              <dd>100GB—1000GB / 月</dd>\n            </div>\n            <div class=\"panel-row\">\n              <dt>设备数量</dt>\n              <dd>3 台—20 台同时在线</dd>\n            </div>\n            <div class=\"panel-row\">\n              <dt>配置流程</dt>\n              <dd>准备 → 添加 → 连接</dd>\n            </div>\n          </dl>\n          <p class=\"panel-note\">本页为信息整理页面，具体服务状态、实际可用范围及交付方式请以购买时展示的信息为准。</p>\n        </aside>\n      </div>\n    </section>\n\n    <section class=\"section section-soft\" id=\"plans\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"section-kicker\">Plan Reference</div>\n            <h2>三档套餐，按需求递进</h2>\n          </div>\n          <p class=\"section-intro\">从个人日常使用到多人协作，套餐差异集中在流量额度、同时在线设备数量与服务内容。以下价格均来自本页提供的套餐参考信息。</p>\n        </div>\n\n        <div class=\"plans\">\n          <article class=\"plan\">\n            <h3>基础版</h3>\n            <p class=\"plan-subtitle\">适合个人设备与轻度日常使用</p>\n            <div class=\"price\">¥15 <small>/ 月</small></div>\n            <p class=\"annual\">按年付 ¥150 / 年</p>\n            <ul>\n              <li>每月 100GB 极速流量</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>解锁基础流媒体</li>\n              <li>普通线路节点池</li>\n            </ul>\n          </article>\n\n          <article class=\"plan\">\n            <span class=\"plan-badge\">推荐档位</span>\n            <h3>旗舰版</h3>\n            <p class=\"plan-subtitle\">适合多设备使用与进阶场景</p>\n            <div class=\"price\">¥35 <small>/ 月</small></div>\n            <p class=\"annual\">按年付 ¥350 / 年</p>\n            <ul>\n              <li>每月 300GB 极速流量</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7×24 优先工单支持</li>\n            </ul>\n          </article>\n\n          <article class=\"plan\">\n            <h3>团队版</h3>\n            <p class=\"plan-subtitle\">适合多人共享与定制路由需求</p>\n            <div class=\"price\">¥85 <small>/ 月</small></div>\n            <p class=\"annual\">按年付 ¥850 / 年</p>\n            <ul>\n              <li>每月 1000GB 极速流量</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n          </article>\n        </div>\n\n        <p class=\"plan-note\">说明：套餐页面中的“极速”“解锁”“优化”等表述为所列套餐权益，不应延伸理解为对所有地区、网站或应用均提供确定性结果。购买前请核对周期、流量、设备数量及退款或续费规则。</p>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"clients\">\n      <div class=\"container clients\">\n        <div>\n          <div class=\"eyebrow\">Client Setup</div>\n          <h2>客户端怎么准备</h2>\n          <p class=\"client-intro\">由于暂无可确认的客户端下载地址，本页不提供外部下载链接。实际配置前，请先取得服务提供方交付的客户端、订阅信息及对应操作说明。</p>\n          <div class=\"notice\">本页未列出的客户端名称、版本号与系统兼容性，不宜自行推断。请以交付页面显示的信息为准，避免安装来源不明的文件。</div>\n        </div>\n\n        <div class=\"client-list\">\n          <article class=\"client-item\">\n            <div class=\"client-index\">01</div>\n            <div>\n              <h3>确认设备与系统</h3>\n              <p>确认准备连接的具体设备，记录其操作系统版本。若有手机、电脑或路由器等多种终端，应分别确认客户端是否支持，避免按相近系统版本直接安装。</p>\n            </div>\n          </article>\n\n          <article class=\"client-item\">\n            <div class=\"client-index\">02</div>\n            <div>\n              <h3>核对订阅信息</h3>\n              <p>准备服务方提供的订阅地址或配置文件。复制后检查开头与结尾是否完整，不要在公开群聊、截图或不受信任的第三方页面中展示凭据。</p>\n            </div>\n          </article>\n\n          <article class=\"client-item\">\n            <div class=\"client-index\">03</div>\n            <div>\n              <h3>添加并更新配置</h3>\n              <p>打开交付说明指定的客户端，添加订阅地址或本地配置文件，随后执行更新。配置列表出现预期条目后，再选择需要的节点进行连接。</p>\n            </div>\n          </article>\n\n          <article class=\"client-item\">\n            <div class=\"client-index\">04</div>\n            <div>\n              <h3>检查连接状态</h3>\n              <p>确认客户端显示已连接后，再访问需要使用的服务。若连接失败，可依次检查网络、订阅更新时间、节点状态与系统授权，不应反复修改不明参数。</p>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section section-soft\" id=\"guide\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"section-kicker\">Getting Started</div>\n            <h2>四步完成基础配置</h2>\n          </div>\n          <p class=\"section-intro\">这是一套通用操作顺序。不同客户端的菜单名称可能不同，配置时应以具体界面和交付说明为准。</p>\n        </div>\n\n        <div class=\"steps\">\n          <article class=\"step\">\n            <h3>获取交付内容</h3>\n            <p>从已确认的来源取得客户端安装包、订阅地址或配置文件，并核对当前所选套餐。</p>\n          </article>\n          <article class=\"step\">\n            <h3>安装正确客户端</h3>\n            <p>选择与当前设备系统匹配的版本。若系统提示权限申请，应先确认来源与用途，再决定是否允许。</p>\n          </article>\n          <article class=\"step\">\n            <h3>导入并更新</h3>\n            <p>粘贴订阅内容或导入配置文件，等待客户端完成解析与更新，确认节点信息正常显示。</p>\n          </article>\n          <article class=\"step\">\n            <h3>选择节点连接</h3>\n            <p>根据实际需求选择节点，连接后检查状态；遇到问题时，先保留错误提示与配置信息以便排查。</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"faq\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"eyebrow\">Frequently Asked Questions</div>\n            <h2>常见问题</h2>\n          </div>\n          <p class=\"section-intro\">以下回答覆盖套餐、客户端与连接排查中的基础问题。涉及退款、续费或账户权益的最终说明，请以购买页面及服务交付信息为准。</p>\n        </div>\n\n        <div class=\"faq-grid\">\n          <section class=\"faq-group\">\n            <h3 id=\"plan-faq-title\">套餐与计费</h3>\n            <details>\n              <summary>基础版、旗舰版和团队版如何区分？</summary>\n              <p>主要区别是每月流量额度、同时在线设备数量和附带服务。基础版为 100GB 与 3 台设备，旗舰版为 300GB 与 5 台设备，团队版为 1000GB 与 20 台设备。</p>\n            </details>\n            <details>\n              <summary>月度价格与年度价格如何对应？</summary>\n              <p>页面参考中，基础版为 ¥15/月、¥150/年；旗舰版为 ¥35/月、¥350/年；团队版为 ¥85/月、¥850/年。实际下单周期及续费价格请在下单页面再次核对。</p>\n            </details>\n            <details>\n              <summary>套餐流量是否每月重置？</summary>\n              <p>所列套餐均写明“每月”对应流量额度，因此可按月度周期理解。是否有未使用流量结转、超额限制或额外计费规则，应以购买页面的完整条款为准。</p>\n            </details>\n          </section>\n\n          <section class=\"faq-group\">\n            <h3 id=\"client-faq-title\">客户端与连接</h3>\n            <details>\n              <summary>为什么本页没有客户端下载链接？</summary>\n              <p>目前没有可确认的下载地址，因此本页不提供外部下载入口。应从实际服务交付页面或已核验的来源获取客户端，避免使用来源不明的安装文件。</p>\n            </details>\n            <details>\n              <summary>订阅地址应该如何添加？</summary>\n              <p>先安装交付说明指定的客户端，再进入订阅或配置管理页面，粘贴完整地址并执行更新。若列表未出现内容，先检查是否多复制了空格、换行或丢失字符。</p>\n            </details>\n            <details>\n              <summary>连接失败时先检查什么？</summary>\n              <p>依次确认设备网络可用、订阅已更新、客户端状态正常、所选节点可用以及系统权限完整。若仍无法解决，记录错误提示并向服务方提交必要信息。</p>\n            </details>\n          </section>\n\n          <section class=\"faq-group\">\n            <h3 id=\"account-faq-title\">设备与账户</h3>\n            <details>\n              <summary>同时在线设备数如何理解？</summary>\n              <p>同时在线设备数表示套餐允许并行连接的设备数量。基础版、旗舰版和团队版参考额度分别为 3 台、5 台和 20 台，具体设备识别方式以客户端及服务说明为准。</p>\n            </details>\n            <details>\n              <summary>更换设备后需要重新购买吗？</summary>\n              <p>通常先确认原设备上的客户端与订阅是否可以迁移或退出，再在新设备中导入相同订阅信息。由于本页没有提供账户迁移规则，不应假定所有套餐均可直接跨设备转移。</p>\n            </details>\n          </section>\n\n          <section class=\"faq-group\">\n            <h3 id=\"service-faq-title\">服务与支持</h3>\n            <details>\n              <summary>团队版的定制服务如何确认？</summary>\n              <p>团队版页面权益包含企业定制路由与专属客户经理服务。实际定制范围、沟通方式、生效时间和服务边界，需要在购买前由服务方单独确认。</p>\n            </details>\n            <details>\n              <summary>如何反馈无法使用的问题？</summary>\n              <p>反馈时建议附上客户端版本、设备与系统、发生时间、所选节点、错误提示以及复现步骤。请先移除订阅地址、账户标识等敏感信息，不要公开完整凭据。</p>\n            </details>\n          </section>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"closing\">\n      <div class=\"container closing-inner\">\n        <div>\n          <h2>从套餐选择开始</h2>\n          <p>先核对使用周期、流量和设备数量，再按交付说明配置客户端。对于购买与连接中的不确定信息，以实际服务页面和订单内容为准。</p>\n        </div>\n        <a class=\"button\" href=\"#plans\">返回套餐对照</a>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"container footer-inner\">\n      <span>IPLC 套餐与客户端使用说明</span>\n      <span>页面信息仅作整理参考，实际权益以购买及交付信息为准</span>\n    </div>\n  </footer>",
